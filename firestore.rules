rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is logged in
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper to get user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if user has admin role
    function isAdmin() {
      return isLoggedIn() && getUserData().role == 'admin';
    }

    // Helper to check if user is admin or manager
    function isAdminOrManager() {
      return isLoggedIn() && (getUserData().role == 'admin' || getUserData().role == 'editor'); // Di users/page.tsx, role manager dipetakan ke 'editor'/'admin'
    }

    // Rules for Users
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Rules for Companies
    match /companies/{companyId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Rules for Projects
    match /projects/{projectId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Rules for Teams
    match /teams/{teamId} {
      allow read: if isLoggedIn();
      allow write: if isAdminOrManager();
    }

    // Rules for Cost People on Project
    match /cost_people_on_project/{costId} {
      allow read: if isLoggedIn();
      allow write: if isAdminOrManager();
    }

    // Rules for Presences
    match /presences/{presenceId} {
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdminOrManager());
      allow update: if isLoggedIn() && (isAdminOrManager() || (resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid));
      allow delete: if isAdminOrManager();
    }

    // Rules for Aktivitas
    match /aktivitas/{aktivitasId} {
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdminOrManager());
      allow update: if isLoggedIn() && (isAdminOrManager() || (resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid));
      allow delete: if isLoggedIn() && (isAdminOrManager() || resource.data.user_id == request.auth.uid);
    }

    // Rules for RAB (Rencana Anggaran Biaya)
    // Staff hanya boleh melihat RAB miliknya, mengedit/mengajukan saat masih draft,
    // dan mengisi laporan setelah dicairkan. Approve, cairkan, dan revisi hanya admin.
    match /rab/{rabId} {
      allow read: if isLoggedIn() && (isAdminOrManager() || resource.data.created_by == request.auth.uid);
      allow create: if isLoggedIn() && (isAdminOrManager() || (
        request.resource.data.created_by == request.auth.uid
        && request.resource.data.rab_status in ['draft', 'submitted']
        && request.resource.data.report_status == 'unreported'
      ));
      allow update: if isLoggedIn() && (isAdminOrManager() || (
        resource.data.created_by == request.auth.uid
        && request.resource.data.created_by == resource.data.created_by
        && (
          (
            resource.data.rab_status == 'draft'
            && request.resource.data.rab_status in ['draft', 'submitted']
            && request.resource.data.report_status == resource.data.report_status
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['project_id', 'project_name', 'cad_number', 'note', 'preparation', 'rab_status', 'updated_at', 'history'])
          )
          ||
          (
            resource.data.rab_status == 'paid'
            && resource.data.report_status in ['unreported', 'draft', 'revision']
            && request.resource.data.rab_status == 'paid'
            && request.resource.data.report_status in ['unreported', 'draft', 'submitted']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['report', 'report_status', 'refund', 'history'])
          )
        )
      ));
      allow delete: if isAdminOrManager();
    }

    // Penghitung nomor RAB per user per tahun: id = {uid}_{tahun}
    match /rab_counters/{counterId} {
      allow read, write: if isLoggedIn() && (isAdminOrManager() || counterId.matches(request.auth.uid + '_[0-9]{4}'));
    }

    match /rab_categories/{categoryId} {
      allow read: if isLoggedIn();
      allow write: if isAdminOrManager();
    }

    match /project_cashbook/{entryId} {
      allow read, write: if isAdminOrManager();
    }

    // Default rule for other collections
    match /{document=**} {
      allow read, write: if isLoggedIn();
    }
  }
}